package views

templ Header(title string) {
	<header class="flex items-center justify-between px-6 py-4 bg-white dark:bg-gray-800 shadow-md">
		<div class="flex items-center space-x-2">
			<button @click="sidebarOpen = !sidebarOpen" class="md:hidden text-gray-500 dark:text-gray-300">
				☰
			</button>
			<h1 class="text-xl font-semibold">{ title }</h1>
		</div>
		<div class="flex items-center space-x-4">
			<!-- Dark mode toggle -->
			<button
				@click="theme = (theme === 'dark' ? 'light' : 'dark')"
				class="px-3 py-2 rounded-lg bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600"
			>
				🌙 / ☀️
			</button>
			<!-- Profile -->
			<div class="w-10 h-10 rounded-full bg-gray-300 dark:bg-gray-600 flex items-center justify-center">
				👤
			</div>
		</div>
	</header>
}
